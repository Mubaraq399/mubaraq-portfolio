# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

# Safe to expose to the browser — protected by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of this site once deployed (used for metadata / OG tags). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: every contact-form message is already saved to Supabase and
# visible in /admin/messages, so this is NOT required for the form to work.
# Set it only if you also want an email notification the instant someone
# submits the form. Create a form at https://formspree.io, copy its
# endpoint (https://formspree.io/f/xxxxxxx), and paste it here. Leaving
# this blank simply skips the extra notification step.
FORMSPREE_ENDPOINT=
